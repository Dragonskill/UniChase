# Use a domain pointing at your Docker server. For local smoke tests use
# SITE_ADDRESS=http://localhost and PUBLIC_ORIGIN=http://localhost.
SITE_ADDRESS=unichase.your-domain.example
PUBLIC_ORIGIN=https://unichase.your-domain.example
# Generate each separately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use hexadecimal values to keep the database URL valid without URL encoding.
POSTGRES_PASSWORD=
JWT_SECRET=
# Optional, used only by the explicit seed command.
ADMIN_EMAIL=
ADMIN_PASSWORD=
