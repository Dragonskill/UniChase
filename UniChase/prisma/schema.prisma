generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model University {
  id                       Int      @id @default(autoincrement())
  name                     String   @unique
  slug                     String?  @unique
  koreanName               String?
  city                     String
  country                  String   @default("South Korea")
  universityType           String   @default("private")
  qsRanking                Int?
  qsRankingLabel           String?
  qsRankingYear            Int?
  rankingSourceNote        String?  @db.Text
  qsSourceUrl              String?
  sourceUrls               String[] @default([])
  lastVerifiedAt           DateTime?
  officialWebsite          String   @unique
  imageUrl                 String?
  logoUrl                  String?
  campusImageUrl           String?
  imageAlt                 String?
  imageSourceUrl           String?
  imageLastVerifiedAt      DateTime?
  description              String   @db.Text
  fullDescription          String?  @db.Text
  programs                 String[] @default([])
  tuitionMin               Int?
  tuitionMax               Int?
  tuitionCurrency          String   @default("KRW")
  admissionRequirements    String[] @default([])
  languagesOfInstruction   String[] @default([])
  scholarshipInfo          String?  @db.Text
  hasScholarships          Boolean? @default(false)
  hasDormitory             Boolean? @default(false)
  housingInfo              String?  @db.Text
  internationalStudentInfo String?  @db.Text
  studentLife              String?  @db.Text
  requiredDocuments        String[] @default([])
  applicationSteps         String[] @default([])
  studyLevels              String[] @default([])
  applicationDeadlines     Json?
  applicationOpenDate      DateTime?
  applicationDeadline      DateTime?
  scholarshipDeadline      DateTime?
  documentDeadline         DateTime?
  tags                     String[] @default([])
  contactEmail             String?
  contactPhone             String?
  contactAddress           String?
  mainColor                String   @default("#15397F")
  acceptanceRate           String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  savedBy                  SavedUniversity[]
  comparisonItems          ComparisonUniversity[]
  deadlineReminders        UserDeadline[]
  studentCouncil           StudentCouncil?
  studentCouncilRoles      StudentCouncilRole[]

  @@index([city])
  @@index([country])
  @@index([universityType])
  @@index([qsRanking])
  @@index([applicationDeadline])
}

model StudentCouncil {
  id                 Int       @id @default(autoincrement())
  universityId       Int       @unique
  name               String
  officialName       String?
  description        String    @db.Text
  websiteUrl         String?
  socialUrl          String?
  contactEmail       String?
  sourceUrl          String?
  verificationStatus String    @default("needs verification")
  lastVerifiedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  associationEnabled Boolean   @default(false)
  logoUrl            String?
  imageId            String?
  foundedYear        Int?
  memberCount        Int?
  telegramUrl        String?
  instagramUrl       String?
  linkedinUrl        String?

  university University           @relation(fields: [universityId], references: [id], onDelete: Cascade)
  roles      StudentCouncilRole[]
  advisors   MajorAdvisor[]
  content    AssociationContent[]
  questions  AdvisorQuestion[]
  image      AssociationImage?    @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([verificationStatus])
  @@index([imageId])
}

model StudentCouncilRole {
  id                 Int      @id @default(autoincrement())
  councilId          Int
  universityId       Int
  adminUserId        Int?
  displayName        String?
  roleTitle          String
  department         String?
  description        String?  @db.Text
  responsibilities   String[] @default([])
  contactEmail       String?
  contactUrl         String?
  avatarUrl          String?
  status             String   @default("pending")
  verificationStatus String   @default("needs verification")
  sourceUrl          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  imageId            String?
  roleShort          String?
  major              String?
  academicYear       String?
  telegramUrl        String?
  instagramUrl       String?
  linkedinUrl        String?
  displayOrder       Int      @default(0)

  council    StudentCouncil    @relation(fields: [councilId], references: [id], onDelete: Cascade)
  university University        @relation(fields: [universityId], references: [id], onDelete: Cascade)
  adminUser  AdminUser?        @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  image      AssociationImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([councilId])
  @@index([universityId])
  @@index([adminUserId])
  @@index([status])
  @@index([verificationStatus])
  @@index([imageId])
  @@index([councilId, status, displayOrder])
}

model AssociationImage {
  id          String               @id @default(uuid())
  contentType String
  bytes       Bytes
  createdAt   DateTime             @default(now())
  councils    StudentCouncil[]
  members     StudentCouncilRole[]
  advisors    MajorAdvisor[]
  content     AssociationContent[]
}

model MajorAdvisor {
  id                 Int               @id @default(autoincrement())
  councilId          Int
  name               String
  major              String
  academicYear       String?
  contactUrl         String?
  photoUrl           String?
  imageId            String?
  active             Boolean           @default(false)
  verificationStatus String            @default("needs verification")
  displayOrder       Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  council            StudentCouncil    @relation(fields: [councilId], references: [id], onDelete: Cascade)
  image              AssociationImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  questions          AdvisorQuestion[]

  @@index([councilId, active, displayOrder])
  @@index([imageId])
}

enum AssociationContentType {
  EVENT
  POST
  INTERVIEW
}

model AssociationContent {
  id          Int                    @id @default(autoincrement())
  councilId   Int
  type        AssociationContentType
  title       String
  description String                 @db.Text
  body        String?                @db.Text
  imageUrl    String?
  imageId     String?
  date        DateTime               @db.Date
  externalUrl String?
  published   Boolean                @default(false)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  council     StudentCouncil         @relation(fields: [councilId], references: [id], onDelete: Cascade)
  image       AssociationImage?      @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([councilId, published, date])
  @@index([imageId])
}

model AdvisorQuestion {
  id              Int             @id @default(autoincrement())
  studentId       Int?
  councilId       Int?
  advisorId       Int?
  advisorName     String
  advisorMajor    String
  associationName String
  universityName  String
  body            String          @db.Text
  handledAt       DateTime?
  createdAt       DateTime        @default(now())
  student         StudentUser?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  council         StudentCouncil? @relation(fields: [councilId], references: [id], onDelete: SetNull)
  advisor         MajorAdvisor?   @relation(fields: [advisorId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([councilId])
  @@index([advisorId])
  @@index([handledAt, createdAt])
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  councilRoles     StudentCouncilRole[]
  moderatorProfile ModeratorProfile?
}

model ModeratorProfile {
  id          Int       @id @default(autoincrement())
  adminUserId Int      @unique
  displayName String
  description String?  @db.Text
  defaultRole String?
  avatarUrl   String?
  contactEmail String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
}

model StudentUser {
  id                        Int                        @id @default(autoincrement())
  name                      String
  email                     String                     @unique
  passwordHash              String
  preferredMajor            String?
  preferredCity             String?
  preferredLevel            String?
  budgetMin                 Int?
  budgetMax                 Int?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  savedUniversities         SavedUniversity[]
  comparisonSets            ComparisonSet[]
  deadlineReminders         UserDeadline[]
  checklistItems            ChecklistItem[]
  recommendationPreferences RecommendationPreference[]
  advisorQuestions           AdvisorQuestion[]
}

model SavedUniversity {
  userId       Int
  universityId Int
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())

  user         StudentUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  university   University  @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@id([userId, universityId])
  @@index([universityId])
}

model ComparisonSet {
  id        Int                    @id @default(autoincrement())
  userId    Int?
  name      String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  user      StudentUser?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ComparisonUniversity[]
}

model ComparisonUniversity {
  id              Int           @id @default(autoincrement())
  comparisonSetId Int
  universityId    Int
  createdAt       DateTime      @default(now())

  comparisonSet   ComparisonSet @relation(fields: [comparisonSetId], references: [id], onDelete: Cascade)
  university      University    @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([comparisonSetId, universityId])
  @@index([universityId])
}

model UserDeadline {
  id           Int         @id @default(autoincrement())
  userId       Int
  universityId Int
  deadlineType String
  important    Boolean     @default(false)
  note         String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user         StudentUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  university   University  @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([userId, universityId, deadlineType])
  @@index([universityId])
}

model ChecklistItem {
  id        Int         @id @default(autoincrement())
  userId    Int
  title     String
  completed Boolean     @default(false)
  dueDate   DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user      StudentUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecommendationPreference {
  id                     Int          @id @default(autoincrement())
  userId                 Int?
  preferredMajor         String?
  preferredCity          String?
  language               String?
  dormitoryRequired      Boolean?
  scholarshipPreferred   Boolean?
  level                  String?
  rankingMin             Int?
  rankingMax             Int?
  tuitionMin             Int?
  tuitionMax             Int?
  results                Json?
  createdAt              DateTime     @default(now())

  user                   StudentUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ContactMessage {
  id                   Int      @id @default(autoincrement())
  name                 String
  email                String
  universityOfInterest String?
  subject              String
  message              String   @db.Text
  status               String   @default("new")
  createdAt            DateTime @default(now())
}
